# Copie para .env.local (no computador) ou cadastre na Vercel em Settings → Environment Variables.
# Depois de alterar variáveis na Vercel, faça um novo deploy (Deployments → ⋯ → Redeploy).

# --- Pagar.me (API v5) -------------------------------------------------------
# Sem as duas chaves, o checkout funciona até a etapa de pagamento e oferece finalizar pelo WhatsApp.
# Chave secreta: só no servidor. Nunca coloque no código nem em variável NEXT_PUBLIC_.
PAGARME_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Chave pública: usada no navegador para tokenizar o cartão.
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# Senha do webhook: invente um texto longo e use o mesmo valor na URL cadastrada na Pagar.me:
# https://agenciavictorhugo.online/api/webhooks/pagarme?token=ESTE_VALOR
PAGARME_WEBHOOK_TOKEN=troque-por-um-texto-longo-e-aleatorio

# --- Área administrativa (/admin) --------------------------------------------
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Opcional: segredo próprio para assinar o cookie de sessão
# ADMIN_SESSION_SECRET=

# --- Pixel da Meta (Facebook/Instagram) --------------------------------------
# Só o número do Pixel (Gerenciador de Eventos). O pixel carrega após o aceite dos cookies.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Banco de reservas -------------------------------------------------------
# Criada automaticamente pela Vercel ao conectar um Blob Store (privado) ao projeto.
# No computador, sem esta variável, as reservas ficam em .data/reservas/.
# BLOB_READ_WRITE_TOKEN=

# --- Opcional ----------------------------------------------------------------
# Força a URL pública usada no sitemap, nas prévias e nos links do voucher.
# NEXT_PUBLIC_SITE_URL=https://agenciavictorhugo.online

# --- Banco de dados (Supabase) ------------------------------------------------
# Endereço do projeto (não é segredo): https://<referência do projeto>.supabase.co
SUPABASE_URL=
# Chave secreta (começa com sb_secret_): só no servidor. Nunca no código nem em variável NEXT_PUBLIC_.
# No Supabase: Project Settings → API Keys → aba "Publishable and secret API keys" → Secret keys.
SUPABASE_SECRET_KEY=
# Só na Vercel: a senha que ela manda no agendamento diário (/api/saude). Invente um texto longo.
# CRON_SECRET=
