# Copie para .env.local (no computador) ou cadastre na Vercel em Settings → Environment Variables.
# Depois de alterar variáveis na Vercel, faça um novo deploy (Deployments → ⋯ → Redeploy).

# --- Pagamento online (Stripe) ------------------------------------------------
# Sem estas chaves, ou com PAGAMENTO_ONLINE desligado, o pedido é registrado e segue pelo WhatsApp.
# Chave RESTRITA do servidor: rk_test_… no modo de teste da conta principal, rk_live_… em produção.
# Permissões: Checkout Sessions escrita; PaymentIntents leitura; Charges leitura; Refunds escrita;
# Disputes leitura; todo o resto (inclusive Webhook Endpoints) nenhuma. Nunca no código nem em NEXT_PUBLIC_.
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxxxxxx
# Assinatura do webhook (whsec_…): uma por destino (computador com stripe listen, prévia e produção).
# Endereço do webhook em produção: https://orlanativa.online/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Chave publicável (pk_test_… / pk_live_…): aparece no navegador para montar o checkout embutido.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
# Quem vê cartão e Pix: desligado (padrão: o pedido segue pelo WhatsApp), admin (só quem entrou no /admin)
# ou publico. Depois de mudar na Vercel, publique de novo.
# PAGAMENTO_ONLINE=desligado

# --- Área administrativa (/admin) --------------------------------------------
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Opcional: segredo próprio para assinar o cookie de sessão
# ADMIN_SESSION_SECRET=

# --- Medição dos anúncios (cada item liga sozinho quando a variável existe) ---
# Pixel da Meta: só o número (Gerenciador de Eventos). Carrega depois do aceite dos cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# API de Conversões: avisa a Meta quando a equipe marca o pedido como pago. Só no servidor.
# No Gerenciador de Eventos: Configurações do Pixel → API de Conversões → Gerar token de acesso.
# META_CAPI_TOKEN=
# Opcional, só para testar: o código da aba "Eventos de teste" do Gerenciador de Eventos.
# META_TEST_EVENT_CODE=
# Tag do Google Ads: o ID que começa com AW-. Carrega depois do aceite dos cookies.
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# Arquivo de vendas pagas que o Google busca todo dia. Invente um texto longo, só com letras e números.
# Ele vira parte do endereço: /api/anuncios/compras-google/ESTE_VALOR.csv
# GOOGLE_ARQUIVO_SEGREDO=

# --- Banco de reservas -------------------------------------------------------
# Na Vercel as reservas ficam no banco (Supabase, abaixo). No computador ficam em .data/reservas/;
# com RESERVAS_NO_BANCO=1 no comando, no banco de verdade (para testar).
# RESERVAS_NO_BANCO=1
# O Blob Store (privado) guarda só as reservas antigas, de antes do banco. Na Vercel esta variável é criada
# sozinha; não ponha no .env.local.
# BLOB_READ_WRITE_TOKEN=

# --- Opcional ----------------------------------------------------------------
# Força a URL pública usada no sitemap, nas prévias e nos links do voucher.
# NEXT_PUBLIC_SITE_URL=https://orlanativa.online

# --- Banco de dados (Supabase) ------------------------------------------------
# Endereço do projeto (não é segredo): https://<referência do projeto>.supabase.co
SUPABASE_URL=
# Chave secreta (começa com sb_secret_): só no servidor. Nunca no código nem em variável NEXT_PUBLIC_.
# No Supabase: Project Settings → API Keys → aba "Publishable and secret API keys" → Secret keys.
SUPABASE_SECRET_KEY=
# Só na Vercel: a senha que ela manda no agendamento diário (/api/saude). Invente um texto longo.
# CRON_SECRET=
